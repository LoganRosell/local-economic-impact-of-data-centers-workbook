{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Centroids Lookup Table Creation Script\"\n",
        "format: html\n",
        "---"
      ],
      "id": "ce563b88"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "from dotenv import load_dotenv\n",
        "from sqlalchemy import create_engine\n",
        "from haversine import haversine, Unit\n",
        "\n",
        "load_dotenv()"
      ],
      "id": "70e7aa40",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# setup connection variables to local sql db\n",
        "database_url = os.getenv(\"DATABASE_URL\")\n",
        "engine = create_engine(database_url)"
      ],
      "id": "6f7f5fe3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Load required table\n",
        "county_df = pd.read_sql_table(\"us_counties\", engine)"
      ],
      "id": "e0e768c5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Prepare Dataframes for merging"
      ],
      "id": "62dd3f18"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "county_lookup = county_df[[\"county_id\", \"centroid_lon\", \"centroid_lat\"]].copy()\n",
        "county_lookup_2 = county_df[[\"county_id\", \"centroid_lon\", \"centroid_lat\"]].copy()\n",
        "\n",
        "county_lookup_2 = county_lookup_2.rename(columns = {\n",
        "    \"county_id\": \"county_id_2\",\n",
        "    \"centroid_lon\": \"centroid_lon_2\",\n",
        "    \"centroid_lat\": \"centroid_lat_2\"\n",
        "})"
      ],
      "id": "0808aaf3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cross-Join Dataframes"
      ],
      "id": "b8f0d392"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "lookup_df = county_lookup.merge(county_lookup_2, how=\"cross\")\n",
        "\n",
        "# drop self-distances\n",
        "lookup_df = lookup_df[lookup_df[\"county_id\"] != lookup_df[\"county_id_2\"]]"
      ],
      "id": "45d7ed0f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Calculate Haversine Distance"
      ],
      "id": "d7329c4d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "lookup_df[\"distance_miles\"] = lookup_df.apply(\n",
        "    lambda row: haversine(\n",
        "        (row[\"centroid_lat\"], row[\"centroid_lon\"]),\n",
        "        (row[\"centroid_lat_2\"], row[\"centroid_lon_2\"]),\n",
        "        unit = Unit.MILES\n",
        "    ),\n",
        "    axis = 1\n",
        ")"
      ],
      "id": "e1c55806",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Finding nearest counties"
      ],
      "id": "d28795a0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def find_nearest_counties(input_df, lookup_df, num_counties = 3):\n",
        "    \"\"\"\n",
        "    For each county in input_df, find num_counties nearest other counties using lookup_df, and append their IDs and distances as new columns\n",
        "    Assumptions:\n",
        "        - lookup_df has columns [county_id, county_id_2, distance_miles]\n",
        "        - input_df has a `county_id` column\n",
        "    \"\"\"\n",
        "    lookup_df = lookup_df[[\"county_id\", \"county_id_2\", \"distance_miles\"]]\n",
        "    lookup_df = lookup_df.sort_values([\"county_id\", \"distance_miles\"])\n",
        "\n",
        "    k_nearest = lookup_df.groupby(\"county_id\").head(num_counties)\n",
        "\n",
        "    k_nearest = k_nearest.copy()\n",
        "    k_nearest[\"rank\"] = k_nearest.groupby(\"county_id\").cumcount() + 1\n",
        "\n",
        "    pivot_df = k_nearest.pivot(\n",
        "        index = \"county_id\",\n",
        "        columns = \"rank\",\n",
        "        values = [\"county_id_2\", \"distance_miles\"]\n",
        "    ).reset_index()\n",
        "\n",
        "    new_cols = []\n",
        "    for col_type, val in pivot_df.columns:\n",
        "        if col_type == \"county_id\":\n",
        "            new_cols.append(\"county_id\")\n",
        "        elif col_type == \"county_id_2\":\n",
        "            new_cols.append(f\"nearest_county_{val}\")\n",
        "        elif col_type == \"distance_miles\":\n",
        "            new_cols.append(f\"nearest_county_{val}_distance\")\n",
        "        else:\n",
        "            new_cols.append(f\"{col_type}_{val}\")\n",
        "\n",
        "    pivot_df.columns = new_cols\n",
        "\n",
        "    output_df = input_df.merge(pivot_df, on=\"county_id\", how = \"left\")\n",
        "\n",
        "    return output_df"
      ],
      "id": "e642db30",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "final_county_df = find_nearest_counties(county_df, lookup_df, 10)"
      ],
      "id": "50c18549",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Update Database"
      ],
      "id": "927b5547"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# setup connection variables to local sql db\n",
        "database_url = os.getenv(\"DATABASE_URL\")"
      ],
      "id": "5dde448d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "lookup_df.to_sql(\n",
        "    \"county_distances_lookup\",\n",
        "    con=engine,\n",
        "    if_exists=\"replace\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "final_county_df.to_sql(\n",
        "    \"us_counties\",\n",
        "    con=engine,\n",
        "    if_exists=\"replace\",\n",
        "    index=False\n",
        ")"
      ],
      "id": "e5bb6130",
      "execution_count": null,
      "outputs": []
    }
  ],
